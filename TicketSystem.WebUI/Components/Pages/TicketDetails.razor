@page "/tickets/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer

@using TicketSystem.Application.Interfaces
@using TicketSystem.Domain.Entities
@using TicketSystem.Domain.Enums

@inject ITicketService TicketService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <div class="mb-4">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/my-tickets"))">
            Quay lại danh sách
        </MudButton>
    </div>

    @if (ticket == null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudGrid Spacing="3">
            <!-- CỘT TRÁI (7 phần): Chi tiết đơn -->
            <MudItem xs="12" md="7">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@ticket.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Mã đơn: @ticket.Id</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string" Dense="true">
                            <MudListItem Icon="@Icons.Material.Filled.Person">
                                <b>Người yêu cầu:</b> @ticket.RequesterName
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Category">
                                <b>Loại đơn:</b> @ticket.Type
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Flag">
                                <b>Độ ưu tiên:</b> @ticket.Priority
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Schedule">
                                <b>Ngày tạo:</b> @ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </MudListItem>
                            @if (ticket.Amount.HasValue)
                            {
                                <MudListItem Icon="@Icons.Material.Filled.AttachMoney">
                                    <b>Số tiền:</b> @ticket.Amount.Value.ToString("N0") VNĐ
                                </MudListItem>
                            }
                            @if (ticket.StartDate.HasValue && ticket.EndDate.HasValue)
                            {
                                <MudListItem Icon="@Icons.Material.Filled.DateRange">
                                    <b>Thời gian:</b> @ticket.StartDate.Value.ToString("dd/MM/yyyy") - @ticket.EndDate.Value.ToString("dd/MM/yyyy")
                                </MudListItem>
                            }
                        </MudList>

                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2">Nội dung chi tiết:</MudText>
                        <MudPaper Elevation="0" Class="pa-3 mt-1 mud-background-gray">
                            <MudText Typo="Typo.body2">@ticket.Description</MudText>
                        </MudPaper>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- CỘT PHẢI (5 phần): Timeline Audit Log -->
            <MudItem xs="12" md="5">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Tiến trình xử lý đơn</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Toàn bộ nhật ký và lịch sử xét duyệt</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudTimeline TimelinePosition="TimelinePosition.Start">

                            <!-- Mốc 1: Khởi tạo đơn -->
                            <MudTimelineItem Color="Color.Info" Icon="@Icons.Material.Filled.Send" Size="Size.Small">
                                <ItemContent>
                                    <MudPaper Elevation="0" Class="pa-3 mud-background-gray rounded">
                                        <div class="d-flex justify-space-between align-center">
                                            <MudText Typo="Typo.subtitle2"><b>@ticket.RequesterName</b> đã gửi</MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Khởi tạo</MudChip>
                                        </div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </MudText>
                                    </MudPaper>
                                </ItemContent>
                            </MudTimelineItem>

                            <!-- Mốc 2: Lịch sử xử lý từ bảng TicketHistory -->
                            @foreach (var history in ticket.Histories.OrderBy(h => h.ActionDate))
                            {
                                var isApproved = history.NewStatus == TicketStatus.Approved;
                                var itemColor = isApproved ? Color.Success : Color.Error;
                                var itemIcon = isApproved ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel;
                                var statusText = isApproved ? "Đã duyệt đơn" : "Đã từ chối đơn";

                                <MudTimelineItem Color="@itemColor" Icon="@itemIcon" Size="Size.Small">
                                    <ItemContent>
                                        <MudPaper Elevation="0" Class="pa-3 mud-background-gray rounded">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.subtitle2"><b>@history.ActorName</b></MudText>
                                                <MudChip T="string" Size="Size.Small" Color="@itemColor" Variant="Variant.Filled">
                                                    @history.NewStatus
                                                </MudChip>
                                            </div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @history.ActionDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </MudText>

                                            @if (!string.IsNullOrWhiteSpace(history.Comment))
                                            {
                                                <MudDivider Class="my-2" />
                                                <MudText Typo="Typo.body2" Style="font-style: italic;">
                                                    "@history.Comment"
                                                </MudText>
                                            }
                                        </MudPaper>
                                    </ItemContent>
                                </MudTimelineItem>
                            }

                            <!-- Mốc chờ (nếu đơn chưa được duyệt/từ chối) -->
                            @if (ticket.Status == TicketStatus.Pending)
                            {
                                <MudTimelineItem Color="Color.Warning" Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small">
                                    <ItemContent>
                                        <MudText Typo="Typo.body2" Color="Color.Warning">
                                            <b>Đang chờ cấp quản lý xem xét...</b>
                                        </MudText>
                                    </ItemContent>
                                </MudTimelineItem>
                            }

                        </MudTimeline>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Ticket? ticket;

    protected override async Task OnInitializedAsync()
    {
        ticket = await TicketService.GetTicketByIdAsync(Id);
    }
}